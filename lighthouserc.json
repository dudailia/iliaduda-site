{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 4500",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://127.0.0.1:4500/",
        "http://127.0.0.1:4500/closebooks",
        "http://127.0.0.1:4500/glacier",
        "http://127.0.0.1:4500/digital-group",
        "http://127.0.0.1:4500/nucarbon"
      ],
      "numberOfRuns": 5,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "_comment": "aggregationMethod is set PER ASSERTION below, never only at the top level. median is the right correction for a numeric budget and the wrong one for a boolean: minScore 1 means «never fails», and a median over five runs cannot express that — an audit failing two of five runs medians to a pass and reports green while the thing it guards is broken forty per cent of the time. pessimistic takes the worst run, so one failure in five fails the assertion, which is what minScore 1 was always asking for. This is the same bug I found and fixed in the debt-portal project's own Lighthouse config; it would have been careless to repeat it here.",
      "assertions": {
        "categories:accessibility": [
          "error",
          { "minScore": 1, "aggregationMethod": "pessimistic" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.005, "aggregationMethod": "median" }
        ],
        "color-contrast": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "heading-order": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "html-has-lang": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "document-title": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "meta-viewport": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "link-name": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "image-alt": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "font-display": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "uses-text-compression": [
          "error",
          { "minScore": 1, "aggregationMethod": "pessimistic" }
        ],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2500, "aggregationMethod": "median" }
        ],
        "total-blocking-time": [
          "error",
          { "maxNumericValue": 200, "aggregationMethod": "median" }
        ],
        "resource-summary:third-party:count": [
          "error",
          { "maxNumericValue": 0, "aggregationMethod": "pessimistic" }
        ],
        "resource-summary:font:size": [
          "error",
          { "maxNumericValue": 76000, "aggregationMethod": "pessimistic" }
        ]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
